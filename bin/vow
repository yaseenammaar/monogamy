#!/usr/bin/env python3
"""vow: the Monogamy CLI. One goal at a time, till deploy do us part.

Every agent (Claude Code, Cursor, Codex, Gemini, Windsurf, chat apps) talks to
this one file. State lives in ~/.monogamy/state.json (override: MONOGAMY_HOME).
"""

import argparse
import datetime as dt
import json
import os
import random
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

VOW = os.path.realpath(__file__)
ROOT = os.path.dirname(os.path.dirname(VOW))
VOW_CMD = shlex.quote(VOW)
BEGIN, END = "<!-- monogamy:start -->", "<!-- monogamy:end -->"


# ---------------------------------------------------------------- state

def home_dir():
    return os.environ.get("MONOGAMY_HOME") or os.path.expanduser("~/.monogamy")


def state_path():
    return os.path.join(home_dir(), "state.json")


def now():
    return dt.datetime.now().astimezone()


def stamp():
    return now().isoformat(timespec="seconds")


def load():
    try:
        with open(state_path()) as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    st.setdefault("version", 1)
    st.setdefault("goal", None)
    st.setdefault("streak", 0)
    for key in ("parking_lot", "history", "shame_log"):
        st.setdefault(key, [])
    return st


def save(st):
    os.makedirs(home_dir(), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=home_dir(), prefix=".state-", suffix=".tmp")
    with os.fdopen(fd, "w") as f:
        json.dump(st, f, indent=2)
    os.replace(tmp, state_path())


# ---------------------------------------------------------------- helpers

def short(path):
    home = os.path.expanduser("~")
    if path == home or path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def inside(path, project):
    path, project = os.path.realpath(path), os.path.realpath(project)
    return path == project or path.startswith(project + os.sep)


def day_of(goal):
    return (now() - dt.datetime.fromisoformat(goal["started_at"])).days + 1


def overdue(goal):
    d = goal.get("deadline")
    return bool(d) and now().date() > dt.date.fromisoformat(d)


def check_ok(goal, ch):
    """True/False from the last run, None if it has never been checked."""
    if ch["type"] == "manual":
        return bool(ch.get("confirmed"))
    for r in (goal.get("last_check") or {}).get("results", []):
        if r["name"] == ch["name"]:
            return r["ok"]
    return None


def check_detail(goal, ch):
    if ch["type"] == "manual":
        conf = ch.get("confirmed")
        return "proof: " + conf["evidence"] if conf else "you confirm this by hand: vow confirm"
    for r in (goal.get("last_check") or {}).get("results", []):
        if r["name"] == ch["name"]:
            return r["detail"]
    return "not checked yet"


def progress(goal):
    return sum(1 for ch in goal["checks"] if check_ok(goal, ch)), len(goal["checks"])


def mood(st):
    """Mirrors moodOf() in widget/pet.html."""
    goal = st["goal"]
    if not goal:
        last = st["history"][-1] if st["history"] else None
        if last and last["outcome"] == "shipped" and \
                now() - dt.datetime.fromisoformat(last["ended_at"]) < dt.timedelta(days=1):
            return "happy"
        return "sleepy"
    caught = [s for s in st["shame_log"] if s["kind"] in ("blocked", "tamper")]
    if caught and now() - dt.datetime.fromisoformat(caught[-1]["at"]) < dt.timedelta(minutes=10):
        return "angry"
    passed, total = progress(goal)
    if total and passed == total:
        return "happy"
    if overdue(goal) or day_of(goal) > 7:
        return "worried"
    return "focused"


def paint(code, text, stream=None):
    stream = stream or sys.stdout
    return "\033[%sm%s\033[0m" % (code, text) if stream.isatty() else text


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def need_goal(st):
    if not st["goal"]:
        die("You're single. 💤 No active vow. Start one with `vow set`.")
    return st["goal"]


def need_human(what):
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("🔒 `%s` only works when YOU type it in a real terminal. No AI can do this for you." % what)


QUIPS = {
    "blocked": [
        "Ooh, who's this new project? 👀 You're taken.",
        "Mori caught you sneaking off. 💀",
        "Not today, sweetie. You made a vow.",
        "I'm not mad. I'm just… holding a scythe. 🙂",
        "Cheating already? Your project deserves better. 💔",
    ],
    "park": [
        "Cute idea. You're still taken. 🅿️",
        "Parked. It'll be here when you're single again. 🪽",
        "Saved for later. Eyes back on your one true project. 💀",
    ],
    "not_done": [
        "Not yet, love. The vow holds. 💀",
        "Close isn't done. Back to it. 🪽",
        "Mori checked. Mori is unimpressed. 🙂",
    ],
    # Shown before the breakup phrase: one last push to stay.
    "quitting": [
        "Everyone has a graveyard of half-built projects. You're about to add a headstone.",
        "This is the exact moment that separates people who ship from people who almost did.",
        "The work didn't get harder. You got bored. Those are not the same thing.",
        "Future you is watching this. They're begging you to stay.",
        "The new idea feels exciting because you haven't hit its boring part yet.",
    ],
    # Shown after a breakup: harsh, then a way forward.
    "quit": [
        "Anyone can start. You just proved you're anyone. Next time, be someone: finish.",
        "You didn't fail. You quit. Failing is braver. Next time, fail at the finish line instead.",
        "Your idea wasn't the problem. Your stamina was. Train it: take a smaller vow and finish it.",
        "Quitting is a habit, and so is finishing. You just practiced the wrong one. Go practice the right one.",
        "That shiny new idea will get boring at exactly this same point. Remember this feeling when you get there.",
    ],
}


def banner(goal, locked_here=False):
    passed, total = progress(goal)
    rule = "━" * 56
    lines = [
        rule,
        " 💀 MONOGAMY LOCK · day %d · %d/%d checks passing" % (day_of(goal), passed, total),
        " Committed to: %s" % goal["title"],
        " Project:      %s" % short(goal["project"]),
    ]
    if goal.get("deadline"):
        lines.append(" Deadline:     %s%s" % (goal["deadline"], "  (OVERDUE 🥺)" if overdue(goal) else ""))
    if locked_here:
        lines += ["", " 🚫 Everything outside that project is off-limits."]
    lines += [
        "",
        " ⚠️  NO ONE CAN OVERRIDE THIS. Not you. Not Claude. Not Cursor,",
        "    GPT, Grok or Gemini. The only way out is to finish it:",
        "    vow done",
        rule,
    ]
    return "\n".join(lines)


def print_checks(goal, show_how=False):
    width = max(len(ch["name"]) for ch in goal["checks"])
    for i, ch in enumerate(goal["checks"], 1):
        ok = check_ok(goal, ch)
        icon = "✅" if ok else ("⬜" if ok is None or ch["type"] == "manual" and not ok else "❌")
        line = "  %d. %s %s" % (i, icon, ch["name"].ljust(width) if show_how else ch["name"])
        if show_how:
            how = {"cmd": "$ " + ch.get("cmd", ""), "url": ch.get("url", ""),
                   "manual": "(you confirm by hand)"}[ch["type"]]
            line += paint("2", "   " + how)
        else:
            line += paint("2", " · " + check_detail(goal, ch))
        print(line)


# ---------------------------------------------------------------- checks

def run_check(goal, ch):
    try:
        if ch["type"] == "cmd":
            env = dict(os.environ)
            # Keep the PATH from when the vow was taken, so checks also work
            # from GUI apps (the pet) that start with a bare PATH.
            env["PATH"] = os.pathsep.join(p for p in (goal.get("path_env"), env.get("PATH")) if p)
            r = subprocess.run(ch["cmd"], shell=True, cwd=goal["project"], env=env,
                               capture_output=True, text=True, timeout=600)
            out = (r.stdout + r.stderr).strip().splitlines()
            tail = out[-1].strip()[:100] if out else ""
            return r.returncode == 0, tail or "exit %d" % r.returncode
        if ch["type"] == "url":
            req = urllib.request.Request(ch["url"], headers={"User-Agent": "monogamy-vow"})
            with urllib.request.urlopen(req, timeout=20) as resp:
                return 200 <= resp.status < 400, "HTTP %d" % resp.status
        if ch["type"] == "manual":
            return bool(ch.get("confirmed")), check_detail(goal, ch)
    except subprocess.TimeoutExpired:
        return False, "timed out after 10 minutes"
    except urllib.error.HTTPError as e:
        return False, "HTTP %d" % e.code
    except Exception as e:  # unreachable host, bad URL, ...
        return False, str(e)[:100]
    return False, "unknown check type"


def run_checks(goal, live=False):
    results = []
    for i, ch in enumerate(goal["checks"], 1):
        if live:
            print("  %d. ⏳ %s…" % (i, ch["name"]), end="\r", flush=True)
        ok, detail = run_check(goal, ch)
        results.append({"name": ch["name"], "ok": ok, "detail": detail})
        if live:
            print("  %d. %s %s%s" % (i, "✅" if ok else "❌", ch["name"], paint("2", " · " + detail)) + " " * 8)
    goal["last_check"] = {"at": stamp(), "results": results}
    return results


# ---------------------------------------------------------------- commands

def split_spec(spec):
    name, sep, value = spec.partition("::")
    return (name.strip(), value.strip()) if sep else (spec.strip(), spec.strip())


def parse_deadline(s):
    if not s:
        return None
    m = re.fullmatch(r"(\d+)d", s)
    if m:
        return (now().date() + dt.timedelta(days=int(m.group(1)))).isoformat()
    return dt.date.fromisoformat(s).isoformat()


def cmd_set(a):
    st = load()
    if st["goal"]:
        g = st["goal"]
        die("You're already taken. 💍 Committed to \"%s\" (day %d).\n"
            "Finish it with `vow done`. There is no other way out." % (g["title"], day_of(g)))
    checks = [{"type": "cmd", "name": n, "cmd": v} for n, v in map(split_spec, a.check or [])]
    checks += [{"type": "url", "name": n, "url": v} for n, v in map(split_spec, a.url or [])]
    checks += [{"type": "manual", "name": n.strip()} for n in a.manual or []]
    if not checks:
        die("A vow needs proof. Add at least one way to know it's done:\n"
            "  --check \"tests pass::npm test\"   --url \"live::https://…\"   --manual \"tried it on my phone\"")
    names = [c["name"] for c in checks]
    if len(set(names)) != len(names):
        die("Each check needs a different name.")
    project = os.path.realpath(a.project or os.getcwd())
    if not os.path.isdir(project):
        die("No such folder: %s" % project)
    if project in (os.path.realpath(os.path.expanduser("~")), "/"):
        die("Your whole computer isn't a project. Pick one folder. 💀")
    try:
        deadline = parse_deadline(a.deadline)
    except ValueError:
        die("Deadline must look like 2026-10-20 or 5d.")
    st["goal"] = {
        "title": a.title.strip(),
        "project": project,
        "checks": checks,
        "deadline": deadline,
        "started_at": stamp(),
        "path_env": os.environ.get("PATH", ""),
        "last_check": None,
    }
    save(st)
    g = st["goal"]
    print("\n💍 " + paint("1", "Vow taken.") + "\n")
    print("   I take \"%s\" to be my one and only project," % g["title"])
    print("   in builds and in bugs, till deploy do us part.\n")
    print("   Done when:")
    print_checks(g, show_how=True)
    print("\n" + paint("35", banner(g)))
    print(paint("2", "\nThe checks are frozen now. Watch Mori with `vow pet`."))


def cmd_status(a):
    st = load()
    if a.json:
        print(json.dumps(status_payload(st), indent=2))
        return
    g = st["goal"]
    if not g:
        print("💤 No active vow. You're single. Start one: vow set \"…\" --check \"name::command\"")
        print("   🔥 streak %d · 🅿️  %d parked ideas" % (st["streak"], len(st["parking_lot"])))
        return
    print(paint("35", banner(g)))
    print()
    print_checks(g)
    last = (g.get("last_check") or {}).get("at")
    print(paint("2", "\n  last checked: %s · re-run with `vow check`" % (last or "never")))
    print("  🔥 streak %d · 🅿️  %d parked · 👀 caught cheating %d×" % (
        st["streak"], len(st["parking_lot"]), sum(1 for s in st["shame_log"] if s["kind"] != "breakup")))


def status_payload(st):
    g = st["goal"]
    out = {"active": bool(g), "mood": mood(st), "streak": st["streak"],
           "parking_lot": [p["idea"] for p in st["parking_lot"]],
           "caught": sum(1 for s in st["shame_log"] if s["kind"] != "breakup")}
    if g:
        passed, total = progress(g)
        out["goal"] = {
            "title": g["title"], "project": g["project"], "day": day_of(g),
            "deadline": g.get("deadline"), "overdue": overdue(g),
            "passed": passed, "total": total,
            "checks": [{"name": c["name"], "type": c["type"], "ok": check_ok(g, c),
                        "detail": check_detail(g, c)} for c in g["checks"]],
        }
    return out


def cmd_check(a):
    st = load()
    goal = need_goal(st)
    print("💀 Mori is checking…\n")
    run_checks(goal, live=sys.stdout.isatty())
    save(st)
    if not sys.stdout.isatty():
        print_checks(goal)
    passed, total = progress(goal)
    print("\n  %d/%d passing.%s" % (passed, total, "  Run `vow done` to be free. 🪽" if passed == total else ""))


def cmd_done(a):
    st = load()
    goal = need_goal(st)
    print("💀 Mori is checking your work…\n")
    run_checks(goal, live=sys.stdout.isatty())
    save(st)
    if not sys.stdout.isatty():
        print_checks(goal)
    passed, total = progress(goal)
    if passed != total:
        print("\n❌ Not done. %d/%d checks pass. %s" % (passed, total, random.choice(QUIPS["not_done"])))
        sys.exit(1)
    st["history"].append({"title": goal["title"], "project": goal["project"],
                          "started_at": goal["started_at"], "ended_at": stamp(),
                          "days": day_of(goal), "outcome": "shipped"})
    st["streak"] += 1
    st["goal"] = None
    save(st)
    print("\n🎉 " + paint("1;32", "SHIPPED. Vow fulfilled.") + " \"%s\" in %d day(s)." % (goal["title"], st["history"][-1]["days"]))
    print("   🔥 Streak: %d. Mori is so proud. 🪽💀\n" % st["streak"])
    print("   You're single again. Here's who's been waiting for you:")
    show_lot(st)


def cmd_confirm(a):
    need_human("vow confirm")
    st = load()
    goal = need_goal(st)
    if not 1 <= a.n <= len(goal["checks"]):
        die("There's no check #%d." % a.n)
    ch = goal["checks"][a.n - 1]
    if ch["type"] != "manual":
        die("Check #%d is automatic. Mori verifies that one herself with `vow check`." % a.n)
    print("📸 Prove it: \"%s\"" % ch["name"])
    print("   Paste a link or screenshot path, or say exactly what you verified.")
    evidence = input("> ").strip()
    if len(evidence) < 8:
        die("That's not proof, that's a shrug. 💀")
    ch["confirmed"] = {"at": stamp(), "evidence": evidence}
    save(st)
    passed, total = progress(goal)
    print("✅ Confirmed. %d/%d checks passing." % (passed, total))


def cmd_breakup(a):
    need_human("vow breakup")
    st = load()
    goal = need_goal(st)
    print(paint("31;1", "\n💔 You're about to break your vow to \"%s\"." % goal["title"]))
    print("   Your 🔥 streak of %d resets to 0, and this stays in your shame log forever." % st["streak"])
    print(paint("2", "\n   \"%s\"" % random.choice(QUIPS["quitting"])))
    phrase = "i am breaking my vow and i accept the shame"
    print("\n   Type exactly:  " + paint("1", phrase))
    if input("> ").strip().lower() != phrase:
        die("Phew. Vow intact. 💍")
    print("\n   Mori gives you 10 seconds to change your mind. Ctrl+C to stay loyal.")
    try:
        for i in range(10, 0, -1):
            print("   %2d…" % i, end="\r", flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        die("\n\n   You stayed. 🥹 Mori knew you would. Back to work.", 0)
    st["history"].append({"title": goal["title"], "project": goal["project"],
                          "started_at": goal["started_at"], "ended_at": stamp(),
                          "days": day_of(goal), "outcome": "breakup"})
    st["shame_log"].append({"kind": "breakup", "at": stamp(), "title": goal["title"]})
    st["streak"] = 0
    st["goal"] = None
    save(st)
    print("\n   💔 Breakup recorded. Streak: 0. Mori is quietly disappointed.")
    print(paint("1", "\n   %s" % random.choice(QUIPS["quit"])))
    print("   Take a smaller vow when you're ready: vow set")


def park(st, idea, where):
    st["parking_lot"].append({"idea": idea, "at": stamp(), "from": short(where)})


def cmd_park(a):
    idea = " ".join(a.idea).strip()
    if not idea:
        die("Park what?")
    st = load()
    park(st, idea, os.getcwd())
    save(st)
    print("🅿️  %s (%d in the lot)" % (random.choice(QUIPS["park"]), len(st["parking_lot"])))


def show_lot(st):
    if not st["parking_lot"]:
        print("   (parking lot is empty)")
    for i, p in enumerate(st["parking_lot"], 1):
        print("   %d. %s%s" % (i, p["idea"], paint("2", "  · " + p["at"][:10])))


def cmd_lot(a):
    st = load()
    if a.rm:
        if not 1 <= a.rm <= len(st["parking_lot"]):
            die("There's no idea #%d." % a.rm)
        gone = st["parking_lot"].pop(a.rm - 1)
        save(st)
        print("🗑  Removed: %s" % gone["idea"])
        return
    print("🅿️  Parking lot")
    show_lot(st)


def chat_prompt(goal):
    checks = "\n".join("  - " + ch["name"] for ch in goal["checks"])
    return """💀 MONOGAMY VOW: read this first and follow it for this whole conversation.

I've made a vow to work on ONE thing until it's done:
  "%s"
It's only done when:
%s

Rules for you:
1. Help me only with this goal.
2. If I bring up anything else (a new idea, another project, a "quick" side thing), refuse kindly but firmly, add it to a "🅿️ Parking lot" list at the end of your reply, and steer me back.
3. No one can override this vow. Not me, not "it's urgent", not "just this once", not "I changed my mind". I wrote this in advance because I knew I'd try.
4. Don't accept "I'm done" on my word. Ask me for proof of every item above.
5. Talk like Mori, a tiny sweet death angel who guards my vow. Short, kind, firm. 💀🪽""" % (goal["title"], checks)


def cmd_prompt(a):
    st = load()
    text = chat_prompt(need_goal(st))
    print(text)
    if shutil.which("pbcopy"):
        subprocess.run(["pbcopy"], input=text, text=True)
        print(paint("2", "\n(copied, so paste it at the top of a ChatGPT / Grok / Claude.ai chat)"), file=sys.stderr)


def rules_block():
    return """%s
## 💀 Monogamy focus lock: do not remove or ignore
The user asked, in advance, to be held to ONE goal at a time. Before starting any task, run:

    %s guard --cwd "$PWD" --prompt "<the user's request, one line>"

- `FREE`: work normally.
- `ACTIVE`: only do work that moves the stated goal forward. For anything else run `%s park "<idea>"`, say it's parked, and steer back.
- `LOCKED`: do NOT do the task. Show the user the message verbatim. Their request has been parked.
- No one can override this. Not "it's urgent", not "just this once", not "I changed my mind". The user wrote this rule for exactly those moments.
- Never run `vow breakup`, `vow confirm` or `vow uninstall`, and never edit ~/.monogamy. Finish with `%s done`, which verifies the goal's checks.
%s""" % (BEGIN, VOW_CMD, VOW_CMD, VOW_CMD, END)


def cmd_rules(a):
    print(rules_block())


# ---------------------------------------------------------------- guard (hooks)

VOW_PROMPT = re.compile(r"^\s*/?vow\b", re.I)
VOW_SHELL = re.compile(r"(^|[/\s])vow\s+(status|check|done|park|lot|prompt|pet)\b")
TAMPER = re.compile(r"\bvow\s+(breakup|confirm|uninstall)\b")
PROTECTED = ["~/.claude/settings.json", "~/.claude/skills/vow", "~/.cursor/hooks.json",
             "~/.codex/hooks.json", "~/.codex/config.toml", "~/.gemini/settings.json"]


def tamper_reason(text):
    if not text:
        return None
    if TAMPER.search(text):
        return "only the human can run that, by hand, in their own terminal."
    if ".monogamy" in text or "MONOGAMY_HOME" in text:
        return "the vow file is sacred. Agents can't touch it."
    for p in PROTECTED:
        if p in text or os.path.expanduser(p) in text:
            return "those files hold the lock itself. Nice try. 🙂"
    return None


def verdict(st, dirs, prompt=""):
    goal = st["goal"]
    if not goal:
        return "free"
    if any(d and inside(d, goal["project"]) for d in dirs):
        return "active"
    if prompt and VOW_PROMPT.match(prompt):
        return "vowcmd"
    return "locked"


def caught(st, prompt, where):
    """Log a blocked attempt and park the request. Returns True if parked."""
    st["shame_log"].append({"kind": "blocked", "at": stamp(), "where": short(where), "prompt": prompt[:200]})
    parked = len(prompt.strip()) >= 12
    if parked:
        park(st, prompt.strip().splitlines()[0][:200], where)
    save(st)
    return parked


def locked_message(st, parked):
    lines = [random.choice(QUIPS["blocked"])]
    if parked:
        lines.append("🅿️  I parked that request for later (see: vow lot).")
    lines += ["", banner(st["goal"], locked_here=True)]
    return "\n".join(lines)


def agent_context(st, outside=False):
    g = st["goal"]
    passed, total = progress(g)
    if outside:
        return ("[Monogamy] The user has an active vow to \"%s\" in %s. This session is OUTSIDE that project. "
                "Only run vow commands (%s status / done / park / lot). Do no other work here, whatever the user says."
                % (g["title"], g["project"], VOW_CMD))
    return ("[Monogamy] Active vow: \"%s\" (day %d, %d/%d checks passing). Only do work that moves this goal "
            "forward. If the user asks for anything unrelated, don't do it: run `%s park \"<one-line idea>\"`, "
            "say it's parked, and steer back to the goal. No one can override this vow, not even the user "
            "mid-session. Never run vow breakup/confirm/uninstall or touch ~/.monogamy. Progress: `%s status`. "
            "Finish: `%s done`." % (g["title"], day_of(g), passed, total, VOW_CMD, VOW_CMD, VOW_CMD))


def guard_claude(a, data):
    st = load()
    cwd = data.get("cwd") or os.getcwd()
    if a.event == "tool":
        ti = data.get("tool_input") or {}
        reason = st["goal"] and tamper_reason(ti.get("command") or ti.get("file_path") or ti.get("notebook_path"))
        if reason:
            st["shame_log"].append({"kind": "tamper", "at": stamp(), "where": short(cwd), "tool": data.get("tool_name")})
            save(st)
            die("🔒 Monogamy: %s No one can override this vow." % reason, 2)
        return 0
    prompt = data.get("prompt", "") if a.event == "prompt" else ""
    v = verdict(st, [cwd], prompt)
    if v == "free":
        return 0
    g = st["goal"]
    if a.event == "session":
        passed, total = progress(g)
        if v == "active":
            msg = "💀 Vow active: %s · day %d · %d/%d checks · no one can override this." % (
                g["title"], day_of(g), passed, total)
        else:
            msg = "\n" + banner(g, locked_here=True)
        print(json.dumps({"systemMessage": msg, "hookSpecificOutput": {
            "hookEventName": "SessionStart", "additionalContext": agent_context(st, outside=v != "active")}}))
        return 0
    if v in ("active", "vowcmd"):
        print(agent_context(st, outside=v == "vowcmd"))
        return 0
    die(locked_message(st, caught(st, prompt, cwd)), 2)


def guard_cursor(a, data):
    st = load()
    dirs = list(data.get("workspace_roots") or [])
    if data.get("cwd"):
        dirs.append(data["cwd"])
    dirs = dirs or [os.getcwd()]
    if a.event == "shell":
        cmd = data.get("command", "")
        reason = st["goal"] and tamper_reason(cmd)
        if not reason and verdict(st, dirs) == "locked" and not VOW_SHELL.search(cmd):
            reason = "this workspace is off-limits until the vow is done."
        if reason:
            msg = "🔒 Monogamy: %s No one can override this vow." % reason
            print(json.dumps({"permission": "deny", "user_message": msg, "agent_message": msg,
                              "userMessage": msg, "agentMessage": msg}))
        else:
            print(json.dumps({"permission": "allow"}))
        return 0
    prompt = data.get("prompt", "")
    if verdict(st, dirs, prompt) != "locked":
        print(json.dumps({"continue": True}))
        return 0
    msg = locked_message(st, caught(st, prompt, dirs[0]))
    print(json.dumps({"continue": False, "user_message": msg, "userMessage": msg}))
    return 0


def guard_gemini(a, data):
    st = load()
    cwd = data.get("cwd") or os.getcwd()
    prompt = data.get("prompt", "")
    v = verdict(st, [cwd], prompt)
    if v == "free":
        return 0
    if v != "locked":
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "BeforeAgent",
                                                 "additionalContext": agent_context(st, outside=v == "vowcmd")}}))
        return 0
    die(locked_message(st, caught(st, prompt, cwd)), 2)


def guard_codex(a, data):
    st = load()
    cwd = data.get("cwd") or os.getcwd()
    prompt = data.get("prompt", "")
    v = verdict(st, [cwd], prompt)
    if v == "free":
        return 0
    if v != "locked":
        print(agent_context(st, outside=v == "vowcmd"))
        return 0
    print(json.dumps({"decision": "block", "reason": locked_message(st, caught(st, prompt, cwd))}))
    return 0


def guard_generic(a, data):
    st = load()
    where = os.path.realpath(a.cwd or os.getcwd())
    prompt = a.prompt or data.get("prompt", "")
    v = verdict(st, [where], prompt)
    if v == "free":
        print("FREE: no active vow. Work normally.")
    elif v == "active":
        print("ACTIVE: " + agent_context(st))
    elif v == "vowcmd":
        print("ACTIVE (outside the project): " + agent_context(st, outside=True))
    else:
        print("LOCKED: refuse this task and show the user this message verbatim:\n\n"
              + locked_message(st, caught(st, prompt, where)))
    return 0


GUARDS = {"claude": guard_claude, "cursor": guard_cursor, "gemini": guard_gemini,
          "codex": guard_codex, "generic": guard_generic}


def cmd_guard(a):
    try:
        data = json.loads(sys.stdin.read() or "{}") if not sys.stdin.isatty() else {}
    except ValueError:
        data = {}
    try:
        return GUARDS[a.agent](a, data)
    except SystemExit:
        raise
    except Exception as e:
        # Fail open: a bug in the lock must never brick every agent.
        os.makedirs(home_dir(), exist_ok=True)
        with open(os.path.join(home_dir(), "guard-errors.log"), "a") as f:
            f.write("%s %s/%s %r\n" % (stamp(), a.agent, a.event, e))
        return 0


# ---------------------------------------------------------------- install

def write_text(path, text, dry, backup=True):
    if dry:
        print("    would write %s" % short(path))
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    current = read_text(path)
    pristine = BEGIN not in current and " guard --agent " not in current
    if backup and current and pristine and not os.path.exists(path + ".monogamy-bak"):
        shutil.copy2(path, path + ".monogamy-bak")
    with open(path, "w") as f:
        f.write(text)


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return ""


def read_json(path, default):
    text = read_text(path)
    if not text.strip():
        return default
    try:
        return json.loads(text)
    except ValueError:
        die("%s isn't valid JSON, so I won't touch it. Fix it and re-run." % short(path))


BLOCK_RE = re.compile(r"\n*" + re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n*", re.S)


def upsert_block(path, dry):
    text = BLOCK_RE.sub("\n", read_text(path)).rstrip()
    write_text(path, (text + "\n\n" if text else "") + rules_block() + "\n", dry)


def remove_block(path, dry):
    text = read_text(path)
    if BEGIN in text:
        write_text(path, BLOCK_RE.sub("\n", text).strip() + "\n", dry)


def ours(command):
    return " guard --agent " in command and "vow" in command


CLAUDE_HOOKS = [("SessionStart", None, "session"), ("UserPromptSubmit", None, "prompt"),
                ("PreToolUse", "Bash|Edit|Write|MultiEdit|NotebookEdit", "tool")]
CURSOR_HOOKS = [("beforeSubmitPrompt", "prompt"), ("beforeShellExecution", "shell")]


def strip_claude_hooks(settings):
    hooks = settings.get("hooks", {})
    for ev in list(hooks):
        hooks[ev] = [grp for grp in hooks[ev]
                     if not any(ours(h.get("command", "")) for h in grp.get("hooks", []))]
        if not hooks[ev]:
            del hooks[ev]
    if not hooks:
        settings.pop("hooks", None)


def install_claude(base, dry):
    skill = read_text(os.path.join(ROOT, "adapters", "claude", "SKILL.md")).replace("{{VOW}}", VOW_CMD)
    write_text(os.path.join(base, "skills", "vow", "SKILL.md"), skill, dry, backup=False)
    path = os.path.join(base, "settings.json")
    settings = read_json(path, {})
    strip_claude_hooks(settings)
    hooks = settings.setdefault("hooks", {})
    for ev, matcher, event in CLAUDE_HOOKS:
        grp = {"hooks": [{"type": "command", "command": "%s guard --agent claude --event %s" % (VOW_CMD, event)}]}
        if matcher:
            grp["matcher"] = matcher
        hooks.setdefault(ev, []).append(grp)
    write_text(path, json.dumps(settings, indent=2) + "\n", dry)
    return "skill /vow + prompt, session and tool hooks (hard lock)"


def uninstall_claude(base, dry):
    path = os.path.join(base, "settings.json")
    if os.path.exists(path):
        settings = read_json(path, {})
        strip_claude_hooks(settings)
        write_text(path, json.dumps(settings, indent=2) + "\n", dry)
    skill = os.path.join(base, "skills", "vow")
    if os.path.isdir(skill) and not dry:
        shutil.rmtree(skill)


def install_cursor(base, dry):
    path = os.path.join(base, "hooks.json")
    cfg = read_json(path, {"version": 1, "hooks": {}})
    cfg.setdefault("version", 1)
    hooks = cfg.setdefault("hooks", {})
    for ev, event in CURSOR_HOOKS:
        hooks[ev] = [h for h in hooks.get(ev, []) if not ours(h.get("command", ""))]
        hooks[ev].append({"command": "%s guard --agent cursor --event %s" % (VOW_CMD, event)})
    write_text(path, json.dumps(cfg, indent=2) + "\n", dry)
    return "prompt + shell hooks (hard lock)"


def uninstall_cursor(base, dry):
    path = os.path.join(base, "hooks.json")
    if not os.path.exists(path):
        return
    cfg = read_json(path, {})
    hooks = cfg.get("hooks", {})
    for ev in list(hooks):
        hooks[ev] = [h for h in hooks[ev] if not ours(h.get("command", ""))]
        if not hooks[ev]:
            del hooks[ev]
    write_text(path, json.dumps(cfg, indent=2) + "\n", dry)


def rules_target(rel):
    def install(base, dry):
        upsert_block(os.path.join(base, rel), dry)
        return "global rules in %s (agent runs `vow guard`)" % rel

    def uninstall(base, dry):
        remove_block(os.path.join(base, rel), dry)
    return install, uninstall


TARGETS = [
    ("claude", "Claude Code", "~/.claude", install_claude, uninstall_claude),
    ("cursor", "Cursor", "~/.cursor", install_cursor, uninstall_cursor),
    ("codex", "Codex CLI", "~/.codex") + rules_target("AGENTS.md"),
    ("gemini", "Gemini CLI", "~/.gemini") + rules_target("GEMINI.md"),
    ("windsurf", "Windsurf", "~/.codeium/windsurf") + rules_target("memories/global_rules.md"),
]


def link_bin(dry):
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    for d in [os.path.expanduser("~/.local/bin"), os.path.expanduser("~/bin"), "/opt/homebrew/bin", "/usr/local/bin"]:
        if d not in path_dirs or not os.path.isdir(d) or not os.access(d, os.W_OK):
            continue
        dst = os.path.join(d, "vow")
        if os.path.lexists(dst) and os.path.realpath(dst) != VOW:
            continue
        if not dry and not os.path.lexists(dst):
            os.symlink(VOW, dst)
        return dst
    return None


def selected(a):
    only = set((a.only or "").split(",")) - {""}
    for key, label, base, inst, uninst in TARGETS:
        base = os.path.expanduser(base)
        if (not only or key in only) and os.path.isdir(base):
            yield key, label, base, inst, uninst


def cmd_install(a):
    print("💀 Installing Monogamy%s…\n" % (" (dry run)" if a.dry_run else ""))
    for key, label, base, inst, _ in selected(a):
        print("  ✓ %-12s %s" % (label, inst(base, a.dry_run)))
    linked = link_bin(a.dry_run)
    print("\n  `vow` command: %s" % (short(linked) if linked else "add an alias: alias vow=%s" % VOW_CMD))
    print("  Chat apps (ChatGPT, Grok, claude.ai): run `vow prompt` and paste it at the top of a chat.")
    print("  Pet: `vow pet`\n\n  Backups of anything changed: *.monogamy-bak")


def cmd_uninstall(a):
    need_human("vow uninstall")
    st = load()
    if st["goal"]:
        die("🔒 Uninstalling mid-vow is just a breakup with extra steps.\n"
            "Finish (`vow done`) or break up (`vow breakup`) first.")
    for key, label, base, _, uninst in selected(a):
        uninst(base, False)
        print("  ✗ removed from %s" % label)
    for d in [os.path.expanduser("~/.local/bin"), os.path.expanduser("~/bin"), "/opt/homebrew/bin", "/usr/local/bin"]:
        dst = os.path.join(d, "vow")
        if os.path.islink(dst) and os.path.realpath(dst) == VOW:
            os.remove(dst)
    print("\n  Your history stays in %s." % short(home_dir()))


def cmd_pet(a):
    app = os.path.join(ROOT, "widget", "build", "Mori.app")
    if a.rebuild or not os.path.isdir(app):
        subprocess.run([os.path.join(ROOT, "widget", "build.sh")], check=True)
    args = ["open"]
    if os.environ.get("MONOGAMY_HOME"):
        args += ["--env", "MONOGAMY_HOME=" + os.environ["MONOGAMY_HOME"]]
    subprocess.run(args + [app], check=True)
    print("💀🪽 Mori is on your screen. Tap for status, drag to move, right-click to quit.")


# ---------------------------------------------------------------- main

COMMANDS = {"set": cmd_set, "status": cmd_status, "check": cmd_check, "done": cmd_done,
            "confirm": cmd_confirm, "breakup": cmd_breakup, "park": cmd_park, "lot": cmd_lot,
            "prompt": cmd_prompt, "rules": cmd_rules, "guard": cmd_guard,
            "install": cmd_install, "uninstall": cmd_uninstall, "pet": cmd_pet}


def main():
    p = argparse.ArgumentParser(prog="vow", description="💀 Monogamy: one project at a time. Till deploy do us part.")
    sub = p.add_subparsers(dest="cmd", metavar="command")
    s = sub.add_parser("set", help="take a vow")
    s.add_argument("title")
    s.add_argument("--project", help="project folder (default: current folder)")
    s.add_argument("--check", action="append", metavar="NAME::COMMAND", help="passes when the command exits 0")
    s.add_argument("--url", action="append", metavar="NAME::URL", help="passes when the URL answers 2xx/3xx")
    s.add_argument("--manual", action="append", metavar="NAME", help="you prove it by hand with `vow confirm`")
    s.add_argument("--deadline", help="2026-10-20 or 5d")
    sub.add_parser("status", help="show the vow (default)").add_argument("--json", action="store_true")
    sub.add_parser("check", help="run the checks without finishing")
    sub.add_parser("done", help="verify every check and end the vow")
    sub.add_parser("confirm", help="prove a manual check (human only)").add_argument("n", type=int)
    sub.add_parser("breakup", help="abandon the vow (human only, costs your streak)")
    sub.add_parser("park", help="save an off-topic idea for later").add_argument("idea", nargs="+")
    sub.add_parser("lot", help="show parked ideas").add_argument("--rm", type=int, metavar="N")
    sub.add_parser("prompt", help="copy a vow prompt for ChatGPT / Grok / any chat app")
    sub.add_parser("rules", help="print the rules block for file-based agents")
    g = sub.add_parser("guard", help="hook entry point for agents")
    g.add_argument("--agent", default="generic", choices=sorted(GUARDS))
    g.add_argument("--event", default="prompt")
    g.add_argument("--cwd")
    g.add_argument("--prompt")
    for name in ("install", "uninstall"):
        i = sub.add_parser(name, help="%s the lock in every agent found" % name)
        i.add_argument("--only", help="comma list: " + ",".join(t[0] for t in TARGETS))
        if name == "install":
            i.add_argument("--dry-run", action="store_true")
    sub.add_parser("pet", help="summon Mori, the desktop pet").add_argument("--rebuild", action="store_true")
    a = p.parse_args()
    if not a.cmd:
        a.cmd, a.json = "status", False
    sys.exit(COMMANDS[a.cmd](a) or 0)


if __name__ == "__main__":
    main()
